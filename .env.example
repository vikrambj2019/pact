# Test/local values only. Copy to .env in the repository root; never commit .env.
DATABASE_URL=postgresql+asyncpg://pact:pact@localhost:5432/pact_enterprise
STORAGE_LOCAL_PATH=./data/uploads
COMPANY_NAME=Pact
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=26214400
MAX_WORKSPACE_WORDS=250000
MAX_JOB_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_POLL_INTERVAL_SECONDS=5
