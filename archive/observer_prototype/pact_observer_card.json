  "messages": [
    {"id": "msg_1", "speaker_id": "person_1", "text": "Our manual workflow consumes substantial staff time. I request $500,000 for automation. It could save $2 million annually if at least 70% of eligible teams adopt it. Those expected savings justify the investment."},
    {"id": "msg_2", "speaker_id": "person_2", "text": "We haven't demonstrated that adoption level. Also, competing projects may deserve funding first."},
    {"id": "msg_3", "speaker_id": "person_1", "text": "Then I propose a $50,000 pilot to test adoption before we commit the full amount."},
    {"id": "msg_4", "speaker_id": "person_3", "text": "I approve the $50,000 pilot. Alex owns execution. Validate adoption before full funding; defer the full implementation decision and review when pilot results are available."}
