# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pact_enterprise

# Object storage (local filesystem for Phase 1)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# LLM
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_RESEARCH_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=120

# Company (display metadata only, not a tenant key)
COMPANY_NAME=Acme Corp

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_WORKSPACE_WORDS=250000

# Worker
MAX_JOB_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_POLL_INTERVAL_SECONDS=5
